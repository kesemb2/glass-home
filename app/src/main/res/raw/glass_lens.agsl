// Liquid-glass lens (AGSL, Android 13+), one pass per glass surface.
//
// Optical model adapted from "Liquid Glass Android" by pandadog (github.com/QWEA0/Liquid-Glass-Android),
// MIT License, Copyright (c) 2025-2026 pandadog. Changes: samples a pre-blurred, screen-sized backdrop (no
// live capture), refracts the screen's scrims along with it, single shape, no touch/press terms, and a cheap path
// for the flat interior (the TV's Mali-G31 runs this at 1080p).
//
// Rounded-rectangle distance field -> outward normal -> bevel profile (inverse-square falloff: most of the
// bending sits in the outermost pixels, which folds the inner backdrop into a compressed ring at the rim) ->
// inward refraction with per-channel dispersion -> vibrancy -> adaptive tint -> two symmetric rim-light lobes.
// Coordinates are the surface's local pixels; output is premultiplied, transparent outside the shape.

uniform shader backdrop;   // screen-sized blurred backdrop; its local matrix maps it onto this surface
uniform float2 size;       // surface size, px
uniform float radius;      // corner radius, px
uniform float bevel;       // width of the bevelled rim, px
uniform float refractPx;   // displacement at the rim, px (inward)
uniform float dispersion;  // per-channel refraction spread
uniform float2 lightDir;   // direction the light travels, unit, y down: (0.866, 0.5) = from the top-left
uniform float spec;        // rim-light strength
uniform float rimBandMax;  // max width of the lit-side glow, px
uniform float saturation;  // vibrancy (1 = unchanged)
uniform float focusTint;   // extra white when focused
uniform float2 origin;     // this surface's top-left on screen, px
uniform float4 shadeX;     // screen scrim, horizontal ramp: (from x, to x, alpha at from, even darkening)
uniform float4 shadeY;     // screen scrim, vertical ramp: (from y, to y, alpha at to, 0)

// The screen's scrims at screen position s, as the fraction of light they let through.
half through(float2 s) {
    float ax = shadeX.z * clamp((s.x - shadeX.y) / (shadeX.x - shadeX.y), 0.0, 1.0);
    float ay = shadeY.z * clamp((s.y - shadeY.x) / (shadeY.y - shadeY.x), 0.0, 1.0);
    return half((1.0 - ax) * (1.0 - ay) * (1.0 - shadeX.w));
}

// Vibrancy (low-saturation colours lifted more than saturated ones, highlights protected), then the adaptive
// tint: lighter over dark content, darker over light content.
half3 finish(half3 col) {
    half lum = dot(col, half3(0.2126, 0.7152, 0.0722));
    half satNow = max(col.r, max(col.g, col.b)) - min(col.r, min(col.g, col.b));
    half room = 1.0 - smoothstep(0.2, 0.85, satNow);
    half hl = 1.0 - smoothstep(0.75, 0.98, lum);
    half amount = 1.0 + (half(saturation) - 1.0) * mix(0.3, 1.0, room * hl);
    col = clamp(mix(half3(lum), col, amount), 0.0, 1.0);
    half e = smoothstep(0.35, 0.75, dot(col, half3(0.2126, 0.7152, 0.0722)));
    return mix(col, half3(1.0 - e), 0.14 + 0.08 * e + half(focusTint));
}

// pow(x, 4.5) for x >= 0, without pow.
half lobe(half x) {
    x = max(x, 0.0);
    half x2 = x * x;
    return x2 * x2 * sqrt(x);
}

half4 main(float2 coord) {
    float2 halfSize = size * 0.5;
    float2 p = coord - halfSize;
    float r = min(radius, min(halfSize.x, halfSize.y));
    float2 q = abs(p) - halfSize + r;
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;

    // Coverage: 1.5 px anti-aliased edge, transparent outside.
    half cov = half(clamp(0.5 - d / 1.5, 0.0, 1.0));
    if (cov <= 0.004) {
        return half4(0.0);
    }
    float depth = -d;
    float bandW = clamp(bevel * 0.3, 2.0, rimBandMax);

    // Flat interior: nothing bends and no rim light reaches it, so one sample is enough.
    if (depth >= max(bevel, bandW + 4.0)) {
        half3 inner = backdrop.eval(coord).rgb * through(coord + origin);
        return half4(finish(inner), 1.0);
    }

    // Outward normal of the rounded box, analytic.
    float2 n = (q.x > 0.0 && q.y > 0.0) ? normalize(q) : (q.x > q.y ? float2(1.0, 0.0) : float2(0.0, 1.0));
    n *= float2(p.x < 0.0 ? -1.0 : 1.0, p.y < 0.0 ? -1.0 : 1.0);

    // Bevel profile: slope 1 at the rim, 0 where the flat interior starts (inverse-square falloff).
    float t = clamp(depth / max(bevel, 1.0), 0.0, 1.0);
    float u = 1.0 / (1.0 + 4.0 * t);
    float slope = max((u * u - 0.04) / 0.96, 0.0);

    // Inward refraction with dispersion; the scrims behind the glass are refracted with the image.
    float2 offset = n * (-slope * refractPx);
    float2 cG = coord + offset;
    half3 col;
    if (slope > 0.002) {
        col = half3(
            backdrop.eval(coord + offset * (1.0 - dispersion * slope)).r,
            backdrop.eval(cG).g,
            backdrop.eval(coord + offset * (1.0 + dispersion * slope)).b);
    } else {
        col = backdrop.eval(cG).rgb;
    }
    col = finish(col * through(cG + origin));

    // Rim light from the same normals: two equal lobes (lit side and the inner reflection opposite), a 2 px
    // hairline just inside the edge, and a soft glow inward on the lit side only. No constant outline.
    if (depth < bandW + 4.0) {
        half facing = half(dot(n, -lightDir));
        half lobeF = lobe(facing);
        half lobeB = lobe(-facing);
        half g = half(clamp(1.0 - (depth - 3.0) / bandW, 0.0, 1.0));
        half glow = half(clamp((depth - 1.0) / 2.0, 0.0, 1.0)) * g * sqrt(g) * cov;
        half hair = half(clamp(1.0 - abs(1.0 - depth) / 2.0, 0.0, 1.0)) * cov;
        col = clamp(col + (hair * 0.70 * (lobeF + lobeB) + glow * 0.10 * lobeF) * half(spec), 0.0, 1.0);
    }
    return half4(col * cov, cov);
}
